   vertex 1 -1 -1
   vertex 1 1 -1
   vertex 1 1 1
  endloop
 endfacet
 facet normal 1 0 0
  outer loop
   vertex 1 -1 -1
   vertex 1 1 1
   vertex 1 -1 1
  endloop
 endfacet
 facet normal 0 -1 0
  outer loop
